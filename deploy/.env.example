# Serval quickstart configuration. Copy to .env (same directory as docker-compose.yml), fill in
# the two required secrets, then `docker compose up -d`.

# REQUIRED — signing key for login tokens. Generate one:
#   openssl rand -base64 32
SERVAL_SIGNING_KEY=

# REQUIRED — the first Admin account, created on first boot only (while the user list is empty).
# Change the password from the app once signed in; this value is ignored after first boot.
SERVAL_ADMIN_PASSWORD=
#SERVAL_ADMIN_USERNAME=admin

# The address(es) a browser is told to send WebRTC live-view media to. Unset, go2rtc discovers
# the host's public address via STUN — fine for a first try, but on a LAN set your Docker host's
# LAN IP or live view will not connect from inside the network. Comma-separate to offer more
# than one (e.g. LAN + a public address for outside access):
#SERVAL_WEBRTC_CANDIDATES=192.168.1.20:8666
#SERVAL_WEBRTC_CANDIDATES=192.168.1.20:8666,203.0.113.4:8666

# Days of recordings to keep. Age-based only, no size cap — size this against the disk behind
# the video volume (six 4K cameras ≈ 300-400 GB/day).
#SERVAL_RETENTION_DAYS=7

# Only needed when an edge CameraModule posts telemetry to this server (matches the module's
# Output:ApiKey). Uncomment the matching line in docker-compose.yml too.
#SERVAL_API_KEY=

# The server image. Override to pin a version (sha-<commit>) or to use your own build.
#SERVAL_IMAGE=ghcr.io/flickersoft/serval-server:latest
