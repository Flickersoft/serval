# Optional overrides for compose.yaml. None is needed — the stack runs with no .env at all. Copy to
# .env beside compose.yaml and uncomment what you want to change.

# Days of recordings to keep. Age-based only, no size cap — size this against the disk behind the
# video volume (six 4K cameras ≈ 300-400 GB/day).
#SERVAL_RETENTION_DAYS=7

# Extra addresses a browser is told to send WebRTC live video to, beyond the one it opened Serval
# at (which is always offered). For viewers outside the LAN: a port-forwarded public address.
# Comma-separate several; offer IPv4 and IPv6 on a dual-stack network.
#SERVAL_WEBRTC_CANDIDATES=203.0.113.4:8666
#SERVAL_WEBRTC_CANDIDATES=203.0.113.4:8666,[2001:db8::20]:8666

# Create the first admin at boot instead of from the browser. Ignored once any account exists.
#SERVAL_ADMIN_USERNAME=admin
#SERVAL_ADMIN_PASSWORD=

# Your own token signing key instead of the one the server generates (`openssl rand -base64 32`).
# Changing it signs every device out.
#SERVAL_SIGNING_KEY=

# The server container's memory ceiling. Recording needs ~2 GB, the full AI stack 8-10 GB.
#SERVAL_MEM_LIMIT=10g

# The server image. Pin a version (e.g. 0.3.0 or sha-<commit>) or use your own build.
#SERVAL_IMAGE=ghcr.io/flickersoft/serval-server:latest

# Leave models out of the fetch-models one-shot (Settings → AI chooses per model instead).
#SKIP_VISION=1
