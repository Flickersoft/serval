<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <!--
      Held on 2.x. The XML comment source generator in Microsoft.AspNetCore.OpenApi emits
      `mediaType.Example = ...`; 3.0 retyped that content dictionary to IOpenApiMediaType, whose
      Example is get-only, so a 3.x resolve fails the compile with CS0200 inside generated code and
      nothing in this repository can be edited to fix it. The 10.0 line declares the incompatibility
      itself — [2.7.5, 3.0.0) — which also holds the transitive floor above NU1903; this reference
      is what takes the newest 2.x rather than that floor. 3.x waits on an ASP.NET major built
      against it.
    -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.0" />
    <PackageReference Include="MongoDB.Driver" Version="3.11.0" />
    <!-- The browsable UI. .NET 10 generates the OpenAPI document but ships no renderer for it. -->
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.20" />
  </ItemGroup>

  <!--
    The same detection library the edge CameraModule runs. A camera gets AI whether or not it has
    an edge device: cameras with a module run it there, module-less cameras have the Server run it
    for them, and both produce the same telemetry.

    This brings sherpa-onnx and LLamaSharp with it. That cost is only paid when
    Serval:ServerAi:Enabled is set — the models are loaded lazily at startup behind that flag, so a
    server that only records never touches them.
  -->
  <ItemGroup>
    <ProjectReference Include="../../Shared/Serval.Ai/Serval.Ai.csproj" />
    <ProjectReference Include="../../Shared/Serval.Ai.Core/Serval.Ai.Core.csproj" />
    <ProjectReference Include="../../Shared/Serval.Contracts/Serval.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The go2rtc reconcile logic is internal; the test suite exercises it directly. -->
    <InternalsVisibleTo Include="Serval.Server.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Serval's Cast Web Receiver, served verbatim to a Cast device. A file beside the binary rather
      than an embedded resource on purpose: an operator debugging a receiver on a television can
      read exactly what their server is handing out, and edit it in place to try something.
    -->
    <Content Include="GoogleHome/Receiver/player.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
