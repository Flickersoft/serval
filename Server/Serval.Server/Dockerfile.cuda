# syntax=docker/dockerfile:1
#
# The NVIDIA variant: the standard image plus a CUDA build of ONNX Runtime, so object detection can
# run with Serval:Ai:Detection:Device = onnx-cuda. Layered on the finished standard image rather
# than duplicating its stages, so the two cannot drift: everything else — VAAPI, Vulkan, the Edge
# TPU natives, the web App — is byte-for-byte the image this is built from.
#
# Build the standard image first, then this on top of it (context is unused but kept at the repo
# root, matching the main Dockerfile):
#
#   docker build -f Server/Serval.Server/Dockerfile      -t serval-server .
#   docker build -f Server/Serval.Server/Dockerfile.cuda -t serval-server:cuda .
#
# Run it with the NVIDIA Container Toolkit installed on the host and the GPU handed to the
# container (`gpus: all` in compose, `--gpus all` with docker run). The toolkit injects the
# driver's libcuda.so.1 at start; nothing driver-side ships here, so the image works with any
# driver new enough for CUDA 12 (R525 or later).
ARG BASE_IMAGE=serval-server
FROM ${BASE_IMAGE}

# ---- ONNX Runtime, CUDA 12 build ----
#
# Microsoft's own prebuilt release, not a source build. The version has to be the 1.27 line: the
# managed binding (Microsoft.ML.OnnxRuntime.Managed 1.27.1, see Serval.Ai.csproj) is API-matched to
# it, and sherpa-onnx's CPU copy in /app is the same 1.27.0. Bump all three together.
#
# CUDA 12 rather than the cuda13 asset: CUDA 13 drops Maxwell, Pascal and Volta, and a GTX 10-series
# card is a common thing to find in a home server. CUDA 12 runs on everything from Maxwell to
# Blackwell.
#
# In its own directory, never /app: sherpa-onnx's CPU libonnxruntime.so lives in
# /app/runtimes/linux-x64/native and the ASR path binds to it by RPATH. Detection reaches this copy
# only through Detection:NativeLibraryPath below. The TensorRT provider is dropped — it needs
# libnvinfer (another ~2 GB) and the CUDA provider is already far beyond what YOLO at 640 needs.
ARG ORT_VERSION=1.27.0
ARG ORT_SHA256=3fed2d2f45f01f8bc1c1597a31afe29efd692c7ea4648d58e1844a8a0d0a48cb
RUN set -eu; \
    tgz=onnxruntime-linux-x64-gpu_cuda12-${ORT_VERSION}.tgz; \
    curl -fsSL --retry 3 -o /tmp/$tgz \
        "https://github.com/microsoft/onnxruntime/releases/download/v${ORT_VERSION}/$tgz"; \
    echo "${ORT_SHA256}  /tmp/$tgz" | sha256sum -c -; \
    mkdir -p /opt/onnxruntime-cuda; \
    tar -xzf /tmp/$tgz -C /tmp; \
    src=/tmp/onnxruntime-linux-x64-gpu_cuda12-${ORT_VERSION}/lib; \
    cp -a "$src"/libonnxruntime.so* "$src"/libonnxruntime_providers_shared.so \
          "$src"/libonnxruntime_providers_cuda.so /opt/onnxruntime-cuda/; \
    rm -rf /tmp/$tgz /tmp/onnxruntime-linux-x64-gpu_cuda12-${ORT_VERSION}

# ---- CUDA 12 + cuDNN 9 runtime libraries ----
#
# Exactly the NEEDED list of libonnxruntime_providers_cuda.so (readelf -d), from NVIDIA's apt
# repository for the base image's Ubuntu release — runtime packages only, no toolkit, no -dev.
# This layer is most of the variant's size; cuBLAS and cuDNN are large and nothing smaller exists.
#
# 12.9 because CUDA's minor-version compatibility means a 12.x runtime newer than the one ORT was
# built against loads it, and 12.9 is the last 12.x. The packages register their own
# /etc/ld.so.conf.d entries. libcuda.so.1 is deliberately absent: it is the driver's, and the
# toolkit mounts the host's copy.
ARG CUDA_PKG=12-9
RUN set -eu; \
    . /etc/os-release; \
    [ "$ID" = ubuntu ] || { echo "Base image is $ID, expected ubuntu: fix the NVIDIA repo path."; exit 1; }; \
    repo="ubuntu$(echo "$VERSION_ID" | tr -d .)"; \
    curl -fsSL --retry 3 -o /tmp/cuda-keyring.deb \
        "https://developer.download.nvidia.com/compute/cuda/repos/$repo/x86_64/cuda-keyring_1.1-1_all.deb"; \
    dpkg -i /tmp/cuda-keyring.deb; \
    rm /tmp/cuda-keyring.deb; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        cuda-cudart-${CUDA_PKG} cuda-nvrtc-${CUDA_PKG} \
        libcublas-${CUDA_PKG} libcufft-${CUDA_PKG} libcurand-${CUDA_PKG} \
        libcudnn9-cuda-12; \
    rm -rf /var/lib/apt/lists/*

# Where detection finds the CUDA build. A location, not a decision: Detection:Device still defaults
# to onnx-cpu, and onnx-cuda is chosen in Settings → AI like any other device.
ENV Serval__Ai__Detection__NativeLibraryPath=/opt/onnxruntime-cuda/libonnxruntime.so.${ORT_VERSION}

# What the NVIDIA Container Toolkit mounts into the container. compute is libcuda for detection;
# video is libnvidia-encode/libnvcuvid, which is what lets the image's ffmpeg use h264_nvenc when
# Serval:Ingest:Encoder names it; utility is nvidia-smi, for "why is the GPU idle" from inside.
ENV NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,video,utility
