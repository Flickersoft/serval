<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Like the CameraModule suite: these tests touch no MongoDB, no ffmpeg, no filesystem
         video — only the decidable, in-memory pieces. Live infra is verified by the run-through
         in the plan, not here. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Serval.Server/Serval.Server.csproj" />
  </ItemGroup>

  <!-- Fixtures for MaskedTrackingOverVideoTests, which composites them into a clip with ffmpeg.
       A real person, because a drawn one is not a person to a detector and the test needs the
       model to actually find something. -->
  <ItemGroup>
    <None Include="Assets/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
