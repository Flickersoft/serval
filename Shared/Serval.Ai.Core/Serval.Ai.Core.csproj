<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Serval.Ai</RootNamespace>
  </PropertyGroup>

  <!--
    Deliberately dependency-free. Both the edge module and the Server reference this, and the
    detection gates in it (MotionScorer, AudioLevelGate) are the code that runs on every frame and
    every audio window — so they must be unit-testable on a fresh clone with no models fetched, no
    native runtime present, and no device attached. Anything needing sherpa-onnx, LLamaSharp or
    ImageSharp belongs in Serval.Ai instead.
  -->

</Project>
